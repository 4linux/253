# Copie este arquivo para .env e preencha os valores.
# Nunca cole chaves de API em chat/conversas com IA — elas ficam
# registradas no histórico. Configure sempre por variável de ambiente ou
# arquivo .env (não versionado — já está no .gitignore).

# --- LLM proprietária (escolha um provider) ---
LLM_PROVIDER=anthropic
# LLM_PROVIDER=openai
# LLM_PROVIDER=openrouter

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-sonnet-5

# --- SLM local (Ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# --- Produção (backend único) ---
# BACKEND_ATIVO=slm ou proprietaria
BACKEND_ATIVO=slm

# --- Custo estimado ---
USD_BRL=5.40

# --- Fine-tuning (opcional — quantos nucleos o container pode usar) ---
# FINETUNE_CPUS=2
